rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // 0. Global Safety Net
    match /{document=**} {
      allow read, write: if false;
    }

    // Allow connectivity check
    match /test/connection {
      allow read: if true;
    }

    // --- Helpers ---
    function isSignedIn() {
      return request.auth != null;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    // --- Validations ---

    function isValidProduct(data) {
      return data.keys().hasAll(['id', 'ownerId', 'name', 'price', 'stock']) &&
             data.keys().size() <= 20 && 
             data.ownerId == request.auth.uid &&
             data.name is string && data.name.size() > 0 &&
             data.price is number &&
             data.stock is number;
    }

    function isValidCustomer(data) {
      return data.keys().hasAll(['id', 'ownerId', 'name', 'balance']) &&
             data.keys().size() <= 20 &&
             data.ownerId == request.auth.uid &&
             data.name is string && data.name.size() > 0 &&
             data.balance is number;
    }

    function isValidTransaction(data) {
      return data.keys().hasAll(['id', 'ownerId', 'type', 'amount', 'createdAt']) &&
             data.keys().size() <= 25 &&
             data.ownerId == request.auth.uid &&
             data.type in ['sale', 'payment', 'credit', 'payment_received', 'credit_given', 'return'] &&
             data.amount is number &&
             data.createdAt is string;
    }

    function isValidSettings(data) {
      return data.keys().hasAll(['ownerId', 'name']) &&
             data.keys().size() <= 25 &&
             data.ownerId == request.auth.uid &&
             data.name is string;
    }

    function isValidExpense(data) {
      return data.keys().hasAll(['id', 'ownerId', 'amount', 'description', 'createdAt']) &&
             data.keys().size() <= 15 &&
             data.ownerId == request.auth.uid &&
             data.amount is number &&
             data.description is string &&
             data.createdAt is string;
    }

    function isValidUserProfile(data) {
      return data.keys().hasAll(['id', 'uid', 'name', 'phone']) &&
             data.keys().size() <= 15 &&
             data.uid == request.auth.uid &&
             data.name is string && data.name.size() > 0 && data.name.size() <= 100 &&
             data.phone is string && data.phone.size() > 0 && data.phone.size() <= 30;
    }

    function isValidChatRoom(data) {
      return data.keys().hasAll(['id', 'participants', 'updatedAt']) &&
             data.keys().size() <= 15 &&
             data.participants is list && data.participants.size() >= 2 && data.participants.size() <= 10 &&
             request.auth.uid in data.participants;
    }

    function isValidChatMessage(data) {
      return data.keys().hasAll(['id', 'roomId', 'senderId', 'type', 'createdAt']) &&
             data.keys().size() <= 15 &&
             data.senderId == request.auth.uid &&
             data.type in ['text', 'voice', 'image', 'call'] &&
             (!('text' in data) || (data.text is string && data.text.size() <= 2000)) &&
             (!('audioData' in data) || (data.audioData is string && data.audioData.size() <= 800000)) &&
             (!('imageData' in data) || (data.imageData is string && data.imageData.size() <= 800000));
    }

    // --- Matches ---

    match /products/{productId} {
      allow get: if isSignedIn() && (resource == null || resource.data.ownerId == request.auth.uid);
      allow list: if isSignedIn() && resource.data.ownerId == request.auth.uid;
      allow create: if isSignedIn() && isValidId(productId) && isValidProduct(incoming());
      allow update: if isSignedIn() && isValidId(productId) && isValidProduct(incoming()) && 
                       incoming().ownerId == existing().ownerId &&
                       incoming().id == existing().id;
      allow delete: if isSignedIn() && existing().ownerId == request.auth.uid;
    }

    match /customers/{customerId} {
      allow get: if isSignedIn() && (resource == null || resource.data.ownerId == request.auth.uid);
      allow list: if isSignedIn() && resource.data.ownerId == request.auth.uid;
      allow create: if isSignedIn() && isValidId(customerId) && isValidCustomer(incoming());
      allow update: if isSignedIn() && isValidId(customerId) && isValidCustomer(incoming()) && 
                       incoming().ownerId == existing().ownerId &&
                       incoming().id == existing().id;
      allow delete: if isSignedIn() && existing().ownerId == request.auth.uid;
    }

    match /transactions/{transactionId} {
      allow get: if isSignedIn() && (resource == null || resource.data.ownerId == request.auth.uid);
      allow list: if isSignedIn() && resource.data.ownerId == request.auth.uid;
      allow create: if isSignedIn() && isValidId(transactionId) && isValidTransaction(incoming());
      allow update: if isSignedIn() && isValidId(transactionId) && isValidTransaction(incoming()) && 
                       incoming().ownerId == existing().ownerId &&
                       incoming().id == existing().id &&
                       incoming().diff(existing()).affectedKeys().hasOnly(['isDeleted', 'deletedAt']);
      allow delete: if isSignedIn() && existing().ownerId == request.auth.uid;
    }

    match /expenses/{expenseId} {
      allow get: if isSignedIn() && (resource == null || resource.data.ownerId == request.auth.uid);
      allow list: if isSignedIn() && resource.data.ownerId == request.auth.uid;
      allow create: if isSignedIn() && isValidId(expenseId) && isValidExpense(incoming());
      allow update: if isSignedIn() && isValidId(expenseId) && isValidExpense(incoming()) && 
                       incoming().ownerId == existing().ownerId &&
                       incoming().id == existing().id;
      allow delete: if isSignedIn() && existing().ownerId == request.auth.uid;
    }

    match /settings/{userId} {
      allow get: if isSignedIn() && userId == request.auth.uid;
      allow write: if isSignedIn() && userId == request.auth.uid && isValidSettings(incoming());
    }

    // Public / Searchable Users for messaging by phone
    match /users/{userId} {
      allow get: if isSignedIn();
      allow list: if isSignedIn();
      allow write: if isSignedIn() && userId == request.auth.uid && isValidUserProfile(incoming());
    }

    // Chat Rooms between participants
    match /chat_rooms/{roomId} {
      allow get: if isSignedIn() && (resource == null || request.auth.uid in resource.data.participants);
      allow list: if isSignedIn() && request.auth.uid in resource.data.participants;
      allow create: if isSignedIn() && isValidChatRoom(incoming());
      allow update: if isSignedIn() && request.auth.uid in existing().participants && isValidChatRoom(incoming());

      // Messages in Chat Room
      match /messages/{messageId} {
        allow get: if isSignedIn();
        allow list: if isSignedIn();
        allow create: if isSignedIn() && isValidChatMessage(incoming());
      }
    }

    // WebRTC Live Voice Calls
    match /calls/{callId} {
      allow get, list, create, update, delete: if isSignedIn();

      match /callerCandidates/{candId} {
        allow get, list, create, update, delete: if isSignedIn();
      }
      match /receiverCandidates/{candId} {
        allow get, list, create, update, delete: if isSignedIn();
      }
    }

    match /scanner_sessions/{shopId} {
      allow get, write, update: if true;
    }
  }
}
